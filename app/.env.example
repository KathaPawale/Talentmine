NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
DATABASE_PATH=./data/talentmine.db

# Generate with: openssl rand -hex 32
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Google OAuth (login) — console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=

# Google Places (company discovery for career-site mining)
GOOGLE_PLACES_API_KEY=

# Groq LLM (role normalization + recruiter classification)
GROQ_API_KEY=
# Optional LLM failover
GEMINI_API_KEY=

# JSearch on RapidAPI (Google for Jobs: LinkedIn/Indeed/Glassdoor coverage)
# Sign up free: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Adzuna (free job API, ~20 countries)
# Sign up free: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Dev only — auto sign-in as a local admin
DEV_AUTH_BYPASS=true

# Public-link mode: no sign-in, every visitor shares a guest account.
# Safe to enable in production for test deployments.
AUTH_DISABLED=false

# Hunter.io exact-person finder (uses known LinkedIn handles first), then domain fallback.
HUNTER_API_KEY=
