{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix app ci",
  "buildCommand": "npm --prefix app run build",
  "outputDirectory": "app/dist/client",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "app/{dist/server/**,seed/**,server/db/migrations/**,node_modules/better-sqlite3/**,node_modules/bindings/**,node_modules/file-uri-to-path/**}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
